{
  "id": "com.xquakshell.example-echo",
  "name": "Example Echo",
  "version": "0.1.0",
  "engine": {
    "type": "go-binary",
    "entry": "plugin-echo"
  },
  "activationEvents": [
    "onStartup",
    "onCommand:echo.ping",
    "onView:echo.panel"
  ],
  "contributions": {
    "commands": [
      {
        "id": "echo.ping",
        "title": "Echo Ping"
      }
    ],
    "views": [
      {
        "id": "echo.panel",
        "location": "sidebar.bottom",
        "title": "Echo"
      }
    ]
  },
  "capabilities": {
    "events": {
      "subscribe": ["core.session.*"],
      "publish": ["plugin.com.xquakshell.example-echo.*"]
    }
  }
}

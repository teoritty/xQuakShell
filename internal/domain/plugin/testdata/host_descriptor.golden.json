{
  "pluginApi": "1.0.0",
  "capabilities": {
    "auth": {
      "version": "1.0.0",
      "features": [
        "provider"
      ]
    },
    "channel": {
      "version": "1.0.0",
      "features": [
        "open"
      ]
    },
    "discovery": {
      "version": "1.0.0",
      "features": [
        "publish",
        "invoke"
      ]
    },
    "events": {
      "version": "1.0.0",

{
  // The GitLab replacement for .github/dependabot.yml. Both are live while the project is
  // mirrored: Dependabot runs on GitHub, Renovate here, and they open the same bumps twice if
  // both platforms are active. That is accepted for now - a duplicate merge request is visible,
  // a missing dependency update is not.
  //
  // Nothing here is auto-merged and nothing should be. A lockfile plus a read of the diff is what
  // makes a dependency bump safer than the CVE it closes; automation that merges without either
  // gives up the only defence this repo has against a bad upstream release.
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],

  // Monday morning UTC, matching the security scan's schedule. A dependency merge request and the
  // scheduled vulnerability scan that might explain it then land in the same window rather than a
  // few days apart.
  timezone: 'Etc/UTC',
  schedule: ['* 6-9 * * 1'],
  prConcurrentLimit: 5,
  semanticCommits: 'enabled',
  semanticCommitType: 'build',
  semanticCommitScope: 'deps',

  // frontend/wailsjs/runtime/package.json is generated by Wails, has no lockfile, and is excluded
  // from `npm audit` in the pipeline for the same reason: it is not a project anyone here
  // maintains, and a bump to it is overwritten by the next `wails generate`.
  ignorePaths: ['frontend/wailsjs/**'],

  packageRules: [
    {
      // Versioned and released together upstream; separate merge requests for them would be three
      // reviews of one decision.
      matchManagers: ['gomod'],
      matchPackageNames: ['golang.org/x/**'],
      groupName: 'golang-x',
    },
    {
      // Both families move as a set upstream and are meaningless to review one package at a time -
      // a codemirror editor with mismatched @codemirror/state and /view does not work.
      matchManagers: ['npm'],
      matchPackageNames: ['codemirror', '@codemirror/**'],
      groupName: 'codemirror',
    },
    {
      matchManagers: ['npm'],
      matchPackageNames: ['@xterm/**'],
      groupName: 'xterm',
    },
    {
      // One grouped merge request for every GitHub action. They are pinned by major tag, so an
      // update is usually a tag repoint rather than a behaviour change, and reviewing them one at
      // a time costs more attention than it returns.
      //
      // Still managed from GitLab even though the workflows only run on GitHub: the mirror is
      // meant to be a working repository the day GitHub is available again, and six months of
      // unbumped actions is not that.
      matchManagers: ['github-actions'],
      groupName: 'github-actions',
    },
    {
      // Wails is written down in five places - go.mod, two `cmd/wails@` pins in
      // .github/workflows/release.yml, WAILS_VERSION in the Makefile and in .gitlab-ci.yml, and
      // the README badge. A bot edits go.mod only, and test/unit/release fails on any of the rest
      // disagreeing except the badge, which no test guards because a badge is a claim rather than
      // a build input.
      //
      // The red test IS the reminder to edit the others. Do that in the merge request rather than
      // adding an ignore rule, because an ignore trades a visible red check for silently never
      // hearing about a new Wails.
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/wailsapp/wails/v2'],
      addLabels: ['needs-manual-version-sync'],
    },
  ],
}

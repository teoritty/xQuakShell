# xQuakShell sync server (xqsyncd). See docs/sync-server.md.
#
# Install: copy the xqsyncd binary to /usr/local/bin, this file to /etc/systemd/system/, then
#   systemctl daemon-reload && systemctl enable --now xqsyncd
# The first start creates the key file and a self-signed certificate in /var/lib/xqsyncd and prints
# the identity fingerprint users compare:  journalctl -u xqsyncd | grep fingerprint
#
# The server runs as a transient user that owns only its state directory. The key file there is what
# keeps a copy of the database from being an offline password-guessing target (spec 9.4), so nothing
# else on the machine can read it.

[Unit]
Description=xQuakShell sync server
Documentation=https://github.com/teoritty/xQuakShell/blob/main/docs/sync-server.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStartPre=/usr/local/bin/xqsyncd init --dir ${STATE_DIRECTORY} --keep-existing --host %H
ExecStart=/usr/local/bin/xqsyncd serve --dir ${STATE_DIRECTORY} --addr :8443
Restart=on-failure
RestartSec=5s

DynamicUser=yes
StateDirectory=xqsyncd
StateDirectoryMode=0700
UMask=0077
LimitCORE=0

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
# Port 8443 needs no capability. To listen below 1024, set CAP_NET_BIND_SERVICE in both of these.
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed

[Install]
WantedBy=multi-user.target

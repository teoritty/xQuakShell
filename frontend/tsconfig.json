{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "baseUrl": ".",
    /**
     * Declared here rather than inherited so a preset bump cannot move it again:
     * @tsconfig/svelte v3 set this false, v5 sets it true, and the change arrived
     * silently inside a Svelte upgrade.
     *
     * It is on, and the seven findings it reported were fixed rather than
     * suppressed - not one `!`, `as` or `@ts-ignore` was added for them. Three
     * were an AppGateway declaring 43 methods optional when the Wails generator
     * emits none; one a `&&` on a string typing as `boolean | ''`; two a guard
     * that proved more than its `boolean` return could carry; one a write path
     * disagreeing with the two beside it. Each was a true statement the types
     * were unable to make.
     *
     * Keep it on. Turning it off to land something is how those seven
     * accumulated unseen in the first place.
     */
    "strict": true,
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
